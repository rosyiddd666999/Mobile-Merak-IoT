# Contoh konfigurasi DEV saja — salin ke .env (yang di-ignore) atau pakai --dart-define.
# JANGAN isi kredensial produksi di file ini.
BASE_URL=
API_KEY_ANDROID=
# CCTV: cukup SALAH SATU — full link (https://host/video_feed?url=rtsp://...)
# ditempel ke CCTV_BASE_URL, ATAU base polos + CCTV_RTSP_URL terpisah.
CCTV_BASE_URL=
CCTV_RTSP_URL=
# MQTT: MQTT_URL sumber tunggal (wajib). MQTT_HOST/PORT opsional legacy —
# bila kosong, host diturunkan otomatis dari MQTT_URL.
MQTT_URL=
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
RTSP_MJPEG_URL=/video_feed
